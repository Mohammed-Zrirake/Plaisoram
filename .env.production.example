APP_ENV=prod
APP_SECRET=your_app_secret_here
DEFAULT_URI=http://YOUR_SERVER_IP

# Neon Database Connection
DATABASE_URL=postgresql://neondb_owner:npg_YOUR_PASSWORD@ep-YOUR-HOST.neon.tech/neondb?sslmode=require

# Mercure Real-time Hub
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://YOUR_SERVER_IP/.well-known/mercure
MERCURE_JWT_SECRET="your_mercure_jwt_secret_key"

# Google Cloud Storage (S3 Interoperability)
B2_BUCKET_NAME=plaisoram-files
B2_KEY_ID=YOUR_GCS_HMAC_ACCESS_KEY
B2_APP_KEY=YOUR_GCS_HMAC_SECRET_KEY
B2_ENDPOINT=https://storage.googleapis.com

# Realtime Socket.io Configuration
JWT_SECRET="your_jwt_secret_key"
REALTIME_INTERNAL_SECRET="your_realtime_internal_secret"
ALLOWED_ORIGINS="https://plaisoram-web.vercel.app,http://localhost:3000,http://YOUR_SERVER_IP"

# Admin API Security
ADMIN_API_KEY=your_admin_api_key
CORS_ALLOW_ORIGIN='*'
